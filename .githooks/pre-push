#!/usr/bin/env bash
# Pre-push hook: run the fast unit tests before allowing a push.
#
# To skip deliberately, use git's own escape hatch:  git push --no-verify
#
# GH #1077: the previous version of this hook could not fail. It piped pytest into `tail`
# and read `$?` (which is `tail`'s status), and it looked for `.venv/bin/python` relative to
# the cwd, so from a linked worktree it fell through to a `python` that does not exist. Every
# push printed "All fast tests passed" having run nothing. The invariants below exist because
# a gate that cannot fail is worse than no gate: it prints green where there is no evidence.
#
# Invariants:
#   1. pytest's own exit status decides the push -- never a pipeline's last stage.
#   2. Paths resolve from the git checkout being pushed, never from the cwd.
#   3. If the tests cannot be RUN, the push FAILS. "Unverifiable" is not "passed".
#   4. At most one run per user executes the suite at a time, and a run never outlives the
#      `git push` that started it. With a dozen agents pushing, parallel suites (each -n 4)
#      overload the machine until every run times out, and a timed-out push leaves its pytest
#      running as an orphan, which makes the next runs slower still. Knobs:
#        ATB_PREPUSH_LOCK_DIR            lock path (default /tmp/atb-pre-push-<uid>.lock)
#        ATB_PREPUSH_LOCK_STALE_SECONDS  take over a lock older than this (default 1200)
#        ATB_PREPUSH_LOCK_WAIT_SECONDS   give up waiting after this; the push FAILS (default 1800)

set -uo pipefail

fail() {
    echo "" >&2
    echo "pre-push: $1" >&2
    echo "pre-push: push aborted. Use 'git push --no-verify' to skip this hook deliberately." >&2
    exit 1
}

LOCK_DIR="${ATB_PREPUSH_LOCK_DIR:-/tmp/atb-pre-push-$(id -u).lock}"
LOCK_STALE="${ATB_PREPUSH_LOCK_STALE_SECONDS:-1200}"
LOCK_WAIT="${ATB_PREPUSH_LOCK_WAIT_SECONDS:-1800}"
HOOK_PID=$$
PARENT_PID="${PPID:-}"
OWN_LOCK=0
PYTEST_PID=""

# Kill the whole pytest process group (xdist workers included), not just the leader.
kill_tests() {
    [ -n "$PYTEST_PID" ] || return 0
    kill -TERM -- "-$PYTEST_PID" 2>/dev/null || kill -TERM "$PYTEST_PID" 2>/dev/null || true
    sleep 1
    kill -KILL -- "-$PYTEST_PID" 2>/dev/null || true
    PYTEST_PID=""
}

release_lock() {
    if [ "$OWN_LOCK" = 1 ] && [ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" = "$HOOK_PID" ]; then
        rm -rf "$LOCK_DIR"
    fi
    OWN_LOCK=0
}

cleanup() {
    kill_tests
    release_lock
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

# mkdir is the atomic primitive (macOS has no flock). Best-effort by design: it smooths load,
# it is not a correctness mechanism, so the worst failure -- two runs at once -- is the old
# behaviour. A lock whose owner is dead, or that is older than LOCK_STALE, is taken over.
acquire_lock() {
    local waited=0 owner started age
    while :; do
        if mkdir "$LOCK_DIR" 2>/dev/null; then
            echo "$HOOK_PID" > "$LOCK_DIR/pid"
            date +%s > "$LOCK_DIR/started"
            OWN_LOCK=1
            return 0
        fi
        owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
        started="$(cat "$LOCK_DIR/started" 2>/dev/null || true)"
        age=0
        case "$started" in ''|*[!0-9]*) ;; *) age=$(( $(date +%s) - started )) ;; esac

        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            echo "pre-push: taking over the lock left by dead run (pid $owner)" >&2
            rm -rf "$LOCK_DIR"
            continue
        fi
        if [ -n "$started" ] && [ "$age" -gt "$LOCK_STALE" ]; then
            echo "pre-push: taking over a lock held ${age}s by pid ${owner:-?} (stale after ${LOCK_STALE}s)" >&2
            rm -rf "$LOCK_DIR"
            continue
        fi
        # No owner and no timestamp: the holder died between mkdir and writing them.
        if [ -z "$owner" ] && [ -z "$started" ] && [ "$waited" -ge 30 ]; then
            rm -rf "$LOCK_DIR"
            continue
        fi
        if [ "$waited" -ge "$LOCK_WAIT" ]; then
            return 1
        fi
        if [ $(( waited % 30 )) -eq 0 ]; then
            echo "pre-push: waiting for another pre-push run (pid ${owner:-?}) to finish..." >&2
        fi
        sleep 5
        waited=$(( waited + 5 ))
    done
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || REPO_ROOT=""
[ -n "$REPO_ROOT" ] || fail "could not resolve the repository root (git rev-parse --show-toplevel failed)."
cd "$REPO_ROOT" || fail "could not enter repository root '$REPO_ROOT'."

# Linked worktrees have no .venv of their own; the interpreter lives in the primary checkout,
# which is the parent of the shared git common dir.
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
case "$COMMON_DIR" in
    "") PRIMARY_ROOT="" ;;
    /*) PRIMARY_ROOT="$(dirname "$COMMON_DIR")" ;;
    *)  PRIMARY_ROOT="$(dirname "$REPO_ROOT/$COMMON_DIR")" ;;
esac

# An interpreter only counts if it can actually run THIS repo's suite -- otherwise the hook
# would "run" and report nothing, which is the defect it exists to prevent. `import pytest`
# alone is too weak: the $VIRTUAL_ENV and PATH candidates are exactly the ones likely to be
# another project's venv, where pytest exists but the repo's deps do not and every collection
# dies on `No module named numpy`. numpy/pandas/xdist are the irreducible core of the suite
# (xdist because the invocation below is parallel).
usable() {
    [ -n "${1:-}" ] && [ -x "$1" ] &&
        "$1" -c "import pytest, numpy, pandas, xdist" >/dev/null 2>&1
}

PYTHON=""
for candidate in \
    "${ATB_PREPUSH_PYTHON:-}" \
    "$REPO_ROOT/.venv/bin/python" \
    "${PRIMARY_ROOT:+$PRIMARY_ROOT/.venv/bin/python}" \
    "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}" \
    "$(command -v python3 2>/dev/null || true)" \
    "$(command -v python 2>/dev/null || true)"
do
    if usable "$candidate"; then
        PYTHON="$candidate"
        break
    fi
done

[ -n "$PYTHON" ] || fail "no Python interpreter able to run this suite (pytest + numpy + pandas + xdist) was found (looked in \$ATB_PREPUSH_PYTHON, $REPO_ROOT/.venv, ${PRIMARY_ROOT:-<no primary>}/.venv, \$VIRTUAL_ENV, PATH). Run 'make deps-dev', or set ATB_PREPUSH_PYTHON."

echo "pre-push: running fast unit tests with $PYTHON"

# Pin src/cli to THIS checkout (GH #1070 source-root guard / worktree shim escape hatch), so a
# push from a worktree tests the worktree's code and not the venv's install-time checkout.
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# Git exports GIT_DIR/GIT_INDEX_FILE/GIT_WORK_TREE/GIT_PREFIX/GIT_QUARANTINE_PATH into hook
# processes. REPO_ROOT above is already resolved, so nothing downstream needs them -- but any
# test that shells out to `git` (e.g. to `git init` a throwaway repo) would otherwise inherit
# GIT_DIR and silently operate on THIS repo instead. That corrupted three test files' git
# fixtures and made every push fail with a false "tests failed" (GH #1148).
unset "${!GIT_@}"

# GH #1147: the shim, the installed hooks and the merge driver cannot be version-controlled, so
# "merged" and "in effect" diverge silently unless something runs their --checks. Every push by
# every human and agent is the one trigger nobody has to remember. Advisory on purpose: a stale
# install must be loud, but it must not block an emergency push. It runs after the `unset`
# above so the checker's own `git` calls discover the repo from the cwd, not from git's env.
CHECKER="$REPO_ROOT/tools/check_install_state.py"
if [ -f "$CHECKER" ]; then
    if ! INSTALL_REPORT="$("$PYTHON" "$CHECKER" 2>&1)"; then
        {
            echo ""
            echo "pre-push: WARNING -- install-required artifacts are out of date (push continues):"
            echo "$INSTALL_REPORT"
            echo ""
        } >&2
    fi
fi

# No pipe: pytest's status must reach $? unfiltered. (`set -o pipefail` plus ${PIPESTATUS[0]}
# would work too, but not piping at all leaves nothing to get wrong.) No -p no:randomly:
# pytest.ini's addopts pass --randomly-seed, which is unparseable once the plugin is
# disabled -- the hook would abort with a usage error instead of running the suite.
# No -x: combined with xdist it ends the session via Interrupted, so a plain test failure
# exits 2 instead of 1 and the diagnosis below cannot tell it from a real interruption.
# pytest.ini's --maxfail=5 already bounds the output.
# -n 4, not -n auto: measured 48s vs 76s serial, while `auto` (one worker per core) came in
# at 76s -- per-worker import overhead and CPU contention eat the gain. Same value, and the
# same reason, as tests/run_tests.py.
acquire_lock || fail "gave up after ${LOCK_WAIT}s waiting for another pre-push run (lock $LOCK_DIR, held by pid $(cat "$LOCK_DIR/pid" 2>/dev/null || echo '?')). The tests were NOT run."

# pytest runs in the background, in its own process group (job control), so that it can be
# killed as a unit -- xdist workers included -- if this hook is interrupted or the `git push`
# that started it is gone. Without that, a push that times out leaves the suite running as an
# orphan. `wait` still hands back pytest's own status, unfiltered.
set -m
"$PYTHON" -m pytest tests/unit/ -q --timeout=30 -m "fast" -n 4 --dist=loadgroup &
PYTEST_PID=$!
set +m

while kill -0 "$PYTEST_PID" 2>/dev/null; do
    if [ -n "$PARENT_PID" ] && ! kill -0 "$PARENT_PID" 2>/dev/null; then
        echo "pre-push: the git process that started this hook is gone; stopping the tests." >&2
        exit 1
    fi
    sleep 1
done
wait "$PYTEST_PID"
STATUS=$?
PYTEST_PID=""
release_lock

# pytest's exit codes are not interchangeable. Reporting "tests failed" for a usage or
# collection error is the same misdiagnosis that hid the original bug: it sends the developer
# hunting a test that is fine, when the real problem is the environment.
case "$STATUS" in
    0) ;;
    1) fail "fast unit tests failed." ;;
    2) fail "fast unit tests failed, or the run was interrupted (pytest exit 2 -- under -n this is also what hitting --maxfail looks like)." ;;
    5) fail "pytest collected no tests (exit 5). The 'fast' suite should never be empty; this points at a broken checkout or pytest config, not at your changes." ;;
    *) fail "pytest could not run the tests (exit $STATUS: usage, collection or internal error -- NOT a test failure). '$PYTHON' is probably missing this repo's dependencies: run 'make deps-dev', or point ATB_PREPUSH_PYTHON at a working interpreter." ;;
esac

echo "pre-push: fast unit tests passed. Pushing..."
exit 0
